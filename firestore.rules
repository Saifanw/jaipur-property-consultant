rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "saif.anwar1618@gmail.com";
    }

    match /crmContacts/{docId} {
      allow read, write: if isAdmin();
    }

    match /publicRequirements/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /publicSubmissions/{docId} {
      allow create: if request.resource.data.status == "pending"
        && request.resource.data.source == "Public Website"
        && request.resource.data.name is string
        && request.resource.data.mobile is string
        && request.resource.data.area is string
        && request.resource.data.propertyType is string
        && request.resource.data.details is string;
      allow read, update, delete: if isAdmin();
    }

    match /publicReviews/{docId} {
      allow read: if resource.data.status == "approved";
      allow create: if request.resource.data.status == "pending"
        && request.resource.data.source == "Public Website"
        && request.resource.data.name is string
        && request.resource.data.comment is string;
      allow read, update, delete: if isAdmin();
    }

    match /publicQuestions/{docId} {
      allow read: if resource.data.status == "approved";
      allow create: if request.resource.data.status == "pending"
        && request.resource.data.source == "Public Website"
        && request.resource.data.propertyId is string
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.question is string
        && request.resource.data.question.size() >= 5
        && request.resource.data.question.size() <= 400
        && !("answer" in request.resource.data)
        && !("replies" in request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    match /crmMatches/{docId} {
      allow read, write: if isAdmin();
    }

    // Website analytics: anonymous visitors can create bounded page-view events.
    // Only the configured admin can read or manage analytics records.
    match /websiteAnalytics/{eventId} {
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == "anonymous"
        && request.resource.data.keys().hasOnly([
          "visitorId", "page", "title", "referrer", "source", "device",
          "userAgentFamily", "createdAt", "uid"
        ])
        && request.resource.data.visitorId is string
        && request.resource.data.visitorId.size() <= 80
        && request.resource.data.page is string
        && request.resource.data.page.size() <= 160
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 160
        && request.resource.data.referrer is string
        && request.resource.data.referrer.size() <= 120
        && request.resource.data.source in ["Direct", "Google", "Social", "Referral"]
        && request.resource.data.device in ["Mobile", "Desktop", "Tablet"]
        && request.resource.data.userAgentFamily in ["Edge", "Chrome", "Firefox", "Safari", "Other"]
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
