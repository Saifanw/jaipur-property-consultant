rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Replace saif.anwar1618@gmail.com with your actual Google admin email.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "saif.anwar1618@gmail.com";
    }

    // Private CRM: only the admin can read/write customer, seller and broker records.
    match /crmContacts/{docId} {
      allow read, write: if isAdmin();
    }

    // Public property/enquiry collections will be added later.
    // Keep everything else locked until those features are implemented.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
