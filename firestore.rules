rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "saif.anwar1618@gmail.com";
    }

    // Private CRM: only the admin can read/write customer, seller and broker records.
    match /crmContacts/{docId} {
      allow read, write: if isAdmin();
    }

    // Public website: visitors can only READ the sanitized requirement cards.
    // Only the admin can create/update/delete these public records.
    match /publicRequirements/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
