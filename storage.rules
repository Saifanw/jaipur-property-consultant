rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Replace saif.anwar1618@gmail.com with your actual Google admin email.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "saif.anwar1618@gmail.com";
    }

    match /crmContacts/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // Approved/public property images are readable by website visitors; only admin can upload/modify.
    match /publicProperties/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
